{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "AllowedHosts": "*",
  "Cors": { "AllowedOrigins": [] },
  "ReverseProxy": {
    "Routes": {
      "disasters": {
        "ClusterId": "disasters-api",
        "Match": { "Path": "/api/{**remainder}" }
      }
    },
    "Clusters": {
      "disasters-api": {
        "Destinations": {
          "local": { "Address": "http://localhost:5156/" }
        }
      }
    }
  }
}
