<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
    <add key="GitHubPackages" value="https://nuget.pkg.github.com/disaster-management-platform/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="GitHubPackages"><package pattern="DisasterPlatform.*" /></packageSource>
    <packageSource key="nuget.org"><package pattern="*" /></packageSource>
  </packageSourceMapping>
</configuration>
